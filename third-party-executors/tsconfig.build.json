{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "paths": {
      "*": ["./*"],
      "@402flow/sdk": ["../dist/index.d.ts"]
    },
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts", "src/**/*.test.ts"]
}