# Copy this file to .env for repo-local SDK example and scenario runs.
# These values belong to the SDK workspace so the examples default to hosted staging
# without reaching into another repo. Override them when you want a local control plane.
# If .env already exists, copy only the entries you need; keep your existing keys.
# Precedence: exported shell variables, then SDK-root .env.local, then .env.

OPENAI_API_KEY="..."
X402FLOW_CONTROL_PLANE_BASE_URL="https://api-staging.402flow.ai"
X402FLOW_ORGANIZATION="acme-labs"
X402FLOW_AGENT="test-agent"

# Responses harness and other SDK examples: set exactly one auth value.
X402FLOW_BOOTSTRAP_KEY="..."
# X402FLOW_RUNTIME_TOKEN="..."

# Optional: first-party scenario-fixture merchant base URL override.
# Defaults to the demo merchant at https://demo-merchant-staging.402flow.ai.
# Set this to http://127.0.0.1:4123 for repo-local self-hosted demo-merchant runs.
# X402FLOW_FIRST_PARTY_MERCHANT_BASE_URL="http://127.0.0.1:4123"

# Hosted Agents API examples: examples/openai-agents-api/README.md
# Uncomment the settings for the example you want to run.
# Both hosted examples use OPENAI_API_KEY above.

# Capability probe only: inert vault canary, no 402flow credentials or payments.
# OPENAI_AGENTS_MODEL="gpt-6-luna"
# Public staging receiver owned by agent-pay/apps/canary-receiver; no local server needed.
# OPENAI_AGENTS_CANARY_URL="https://o5xbe3yzugmcpoe4e7mrde24v40onqox.lambda-url.us-east-1.on.aws/probe"

# Hosted testnet purchase: select an agent and configure its bootstrap key below.
# Uses X402FLOW_ORGANIZATION above and the fixed staging API / Base Sepolia merchant.
# Agent values are 402flow external IDs, not UUIDs or OpenAI agent IDs.
# Each bootstrap key must belong to its corresponding agent in the AWS workspace.
# Success profile (default):
# OPENAI_AGENTS_AGENT="openai-agents-test"
# OPENAI_AGENTS_BOOTSTRAP_KEY="..."
# Denial profile (select with --agent-profile denied); both pairs can stay configured.
# OPENAI_AGENTS_DENIED_AGENT="openai-agents-denied-test"
# OPENAI_AGENTS_DENIED_BOOTSTRAP_KEY="..."
# Operator token: setup/evidence access and permission to revoke runtime sessions.
# OPENAI_AGENTS_OPERATOR_TOKEN="..."

# These integration values let other SDK examples retain their existing agent/key
# and localhost API defaults. The hosted purchase still targets staging.
# Bootstrap and operator credentials stay local; the launcher creates the runtime
# token and delivers it through a vault. Do not configure a hosted runtime token.
# Success-profile fallbacks when integration overrides are omitted: X402FLOW_AGENT,
# X402FLOW_BOOTSTRAP_KEY, and OPERATOR_BEARER_TOKEN. The bootstrap fallback requires
# X402FLOW_CONTROL_PLANE_BASE_URL="https://api-staging.402flow.ai".
# The denial profile requires its own agent/key; it never uses the success or SDK key.
# A configured but empty key fails; a failed exchange never retries another key.
# OPERATOR_BEARER_TOKEN="..."

# Paid-run settings also require a JSON file, not additional environment variables:
# copy examples/openai-agents-api/paid-request.config.example.json to ignored tmp/.
# Set organizationId, agentId, requestPolicyId, budgetPolicyId, a new operationId,
# model, expectedOutcome, maxAmountMinor, and maxBudgetAmountMinor in that file.
# For openai-agents-denied-test, use its agent/policy UUIDs and expectedOutcome="review".
# Its seeded 999-minor-unit per-request cap blocks the fixed 1000-unit purchase;
# leave the resulting policy review unapproved. Use a separate config such as
# tmp/paid-request-denied.json. Set credentialId to the matching credential if supplied.
# OPENAI_AGENTS_MODEL and OPENAI_AGENTS_CANARY_URL apply only to the capability probe.
# Setup command (read-only):
# npm run example:openai-agents-api -- paid-preflight --config tmp/paid-request-success.json
# npm run example:openai-agents-api -- paid-preflight --agent-profile denied --config tmp/paid-request-denied.json
